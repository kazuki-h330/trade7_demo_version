# ---- Database ----
# Production: PostgreSQL 15+. Leave empty in development to use the embedded PGlite database (.data/pglite).
DATABASE_URL=

# ---- Security (REQUIRED in production) ----
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store in a secret manager / KMS, never in the database. Dev auto-generates .data/dev-code.key.
CODE_ENCRYPTION_KEY=
# Separate secret for gift-code fingerprints (duplicate detection). Same format as above.
CODE_HASH_PEPPER=
# Protects /api/cron (auto-confirm + mail outbox) when triggered by an external scheduler.
CRON_SECRET=change-me

# ---- Mail ----
# e.g. smtp://user:pass@smtp.example.com:587  — empty = emails are recorded in the outbox only (dev).
SMTP_URL=
MAIL_FROM="trade7 <no-reply@example.com>"
OPS_EMAIL=ops@example.com

# ---- Gemini (prohibited-message detection) ----
# Empty = local heuristic fallback. Rules always run first; messages that hit a rule are never sent to the AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- App ----
APP_URL=http://localhost:3000
# Seed demo accounts when the database is empty (never enable in production).
AUTO_SEED=true
